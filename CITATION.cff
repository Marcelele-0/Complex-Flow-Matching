cff-version: 1.2.0
message: "If you use this software, please cite both the software and the paper."
title: "CyFM: Cylindrical Flow Matching"
abstract: >-
  Generative flow matching for complex-valued fields on the cylinder R+ x S^1,
  with joint minibatch optimal-transport couplings, geodesic bridges, Heun
  solvers and the structural metrics used to score them.
type: software
license: MIT
# Author names, their affiliation and the repository link are withheld for
# double-blind review; five authors are listed as one anonymous entry rather than
# five, since the count is itself a weak identifier. The camera-ready restores them.
# The file stays valid CFF instead of being deleted, so the metadata a tool reads is
# the metadata the paper will carry.
repository-code: "withheld for double-blind review"
authors:
  - name: "Anonymous Authors"
preferred-citation:
  type: article
  title: "CyFM: Cylindrical Optimal Transport for Few-Step Complex-Valued Flow Matching"
  year: 2026
  authors:
    - name: "Anonymous Authors"
