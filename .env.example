# Environment Configuration Template
# Copy this file to .env and configure as needed:
#   cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored. Keep it free of secrets - no passwords or sensitive tokens.
# Put WANDB_API_KEY in your shell instead (`export WANDB_API_KEY=...`).

# ==============================================================================
# Dataset Auto-Download Configuration
# ==============================================================================

# SKM-TEA
# Downloaded automatically from Hugging Face Hub via `huggingface_hub`.
# Optional: Hugging Face user access token if needed for private/gated access
# HF_TOKEN=""
# SKM_TEA_HF_REPO="arjundd/skm-tea-mini"

# fastMRI (Requires signed download URLs from NYU Langone. Links expire in 90 days)
# 1. Mini Subset (Smoke test) - Paste a single URL or multiple URLs on new lines enclosed in quotes
FASTMRI_MINI_URLS="
https://fastmri-dataset.s3.amazonaws.com/v2.0/knee_multicoil_val.tar.xz?...
"

# 2. Full Cohort - Paste all multi-coil training and validation URLs starting on new lines (enclosed in quotes)
FASTMRI_FULL_URLS="
https://fastmri-dataset.s3.amazonaws.com/v2.0/knee_multicoil_train_batch_0.tar.xz?...
https://fastmri-dataset.s3.amazonaws.com/v2.0/brain_multicoil_train_batch_0.tar.xz?...
"
