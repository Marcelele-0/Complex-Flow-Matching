# Environment Configuration Template
# Copy this file to .env and configure as needed:
#   cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored. Keep it free of secrets - no passwords or sensitive tokens.
# scripts/launch_slurm.sh runs on the PLGrid login node and reads `.env` from the
# checkout there. Authentication should use SSH keys or agent, never secrets in this file.
# Put WANDB_API_KEY in your shell instead (`export WANDB_API_KEY=...`).

# ==============================================================================
# Dataset Auto-Download Configuration
# ==============================================================================

# SKM-TEA
# Downloaded automatically from Hugging Face Hub via `huggingface_hub`.
# Optional: Hugging Face user access token if needed for private/gated access
# HF_TOKEN=""
# SKM_TEA_HF_REPO="arjundd/skm-tea-mini"

# fastMRI (Requires signed download URLs from NYU Langone. Links expire in 90 days)
# 1. Mini Subset (Smoke test) - Paste a single URL or multiple URLs on new lines enclosed in quotes
FASTMRI_MINI_URLS="
https://fastmri-dataset.s3.amazonaws.com/v2.0/knee_multicoil_val.tar.xz?...
"

# 2. Full Cohort - Paste all multi-coil training and validation URLs starting on new lines (enclosed in quotes)
FASTMRI_FULL_URLS="
https://fastmri-dataset.s3.amazonaws.com/v2.0/knee_multicoil_train_batch_0.tar.xz?...
https://fastmri-dataset.s3.amazonaws.com/v2.0/brain_multicoil_train_batch_0.tar.xz?...
"

# ==============================================================================
# PLGrid / HPC Cluster Configuration (scripts/launch_slurm.sh)
# ==============================================================================
# Verified 2026-07-22. Confirm against live `hpc-grants` / `hpc-fs` / `sinfo` before a
# first run: the compute account and the storage group are DIFFERENT identifiers and
# neither can be derived from the other. Both are overridable on the command line
# (--account, --partition) and by exported environment variables.
PLG_GRANT=plg-example-gpu-a100
PLG_PARTITION=plgrid-gpu-a100
PLG_GROUP=replace-with-hpc-fs-group

# --- Reference only: no script reads these ---
# The host and login you type into `ssh` and `rsync` yourself:
PLG_HOST=athena.cyfronet.pl
PLG_LOGIN=plg_example

